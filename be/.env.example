# Copy to .env and fill in local values. Never commit .env.

# PostgreSQL connection string (Supabase direct or session pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Server
PORT=5001
NODE_ENV=development

# Restrict CORS to the frontend origin (comma-separated if needed)
CORS_ORIGIN=http://localhost:5173

# JWT — use at least 32 random characters. Never commit real secrets.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d

# Used only by npm run seed:admin — never commit real credentials
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
