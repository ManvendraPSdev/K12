# Copy to .env and fill in local values. Never commit .env.

# PostgreSQL connection string (Supabase direct or session pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Server
PORT=5000
NODE_ENV=development

# Restrict CORS to the frontend origin
CORS_ORIGIN=http://localhost:5173

# JWT (generate a long random secret for production)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Used only by scripts/seed-admin.js — never commit real credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
