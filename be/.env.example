# ==============================================================================
# Backend Environment Configuration (.env.example)
# Copy this file to .env and fill in local or deployment values.
# NEVER commit real .env files with secrets or credentials to Git.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=8000

# PostgreSQL Database Connection String (Supabase direct or connection pooler)
# Format: postgresql://USER:PASSWORD@HOST:5432/postgres
# For Supabase connection pooler: postgresql://USER:PASSWORD@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@[POOLER_HOST]:5432/postgres"

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (no wildcards in production)
CORS_ORIGIN="http://localhost:5173"

# JWT Authentication
# Minimum 32 random characters used for HMAC-SHA256 signing
JWT_SECRET="replace-with-at-least-32-random-characters-secret"
JWT_EXPIRES_IN="1d"

# Admin Initial Seed Credentials
# Used exclusively by 'npm run seed:admin' to seed the initial administrative user
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
