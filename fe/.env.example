# Backend API Base URL (Express 5 API mount point)
# Local development: http://127.0.0.1:8000/api/v1
# Production deployment: https://your-backend-service.onrender.com/api/v1
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
